{% autoescape 'html' %}
{% include '@gitpull/diagnostics.html.twig' %}
{% if notice %}<div class="alert alert-success">{{ notice }}</div>{% endif %}
<div class="card p-3" data-gitpull-dashboard data-refresh-url="{{ base }}dashboard.php?gitpull_async=1">
  <div data-gitpull-feedback role="status" aria-live="polite" hidden></div>
  <h1><i class="ti ti-brand-git text-primary me-2" aria-hidden="true"></i>Plugin Git Gestion — Tableau de bord</h1>
  <p><a class="btn btn-primary" href="{{ base }}repository.form.php"><i class="ti ti-plus me-1" aria-hidden="true"></i>Ajouter un dépôt</a></p>
  {% if error %}<div class="alert alert-danger">{{ error }}</div>{% endif %}
  <div class="table-responsive"><table class="table">
    <thead class="bg-primary-lt"><tr><th>Dépôt</th><th>État</th><th>Dernier check</th><th>Dernier pull réussi</th><th>Prochain check / pull</th><th>Actions</th></tr></thead>
    <tbody>
    {% for row in rows %}
      <tr data-gitpull-repository="{{ row.repo.id }}">
        <td><strong>{{ row.repo.id }}</strong><br>{{ row.repo.url }}<br><code>{{ row.target }}</code></td>
        {% set status_styles = {
          'ready': ['success', '✓'],
          'update_available': ['warning', '↓'],
          'running': ['info', '↻'],
          'error': ['danger', '!'],
          'unknown': ['secondary', '○']
        } %}
        {% set appearance = status_styles[row.status]|default(status_styles.unknown) %}
        <td aria-live="polite">
          <span class="badge bg-{{ appearance[0] }}-lt text-{{ appearance[0] }} rounded-pill px-3 py-2 d-inline-flex align-items-center gap-2 text-wrap text-start lh-sm" data-gitpull-status-badge>
            <span data-gitpull-status-icon aria-hidden="true">{{ appearance[1] }}</span>
            <span data-gitpull-status>{{ row.label }}</span>
          </span>
          {% if row.state.error|default(null) %}<div class="text-danger mt-1" data-gitpull-error>{{ row.state.error }}</div>{% endif %}
        </td>
        <td data-gitpull-last-check>{{ row.state.last_check|default(null) ? row.state.last_check|date('d/m/Y H:i:s') : 'Jamais' }}</td>
        <td data-gitpull-last-pull>{{ row.state.last_pull_success|default(null) ? row.state.last_pull_success|date('d/m/Y H:i:s') : 'Jamais' }}</td>
        <td>
          Check : <span data-gitpull-due="{{ row.next_check ?? '' }}">{{ row.next_check ? 'Calcul…' : 'Désactivé' }}</span><br>
          Pull : <span data-gitpull-due="{{ row.next_pull ?? '' }}">{{ row.next_pull ? 'Calcul…' : 'Désactivé' }}</span>
        </td>
        <td>
          <form class="d-flex flex-wrap align-items-center gap-2 mb-2" method="post" action="{{ base }}dashboard.php" data-gitpull-action>
            <input type="hidden" name="gitpull_csrf" value="{{ csrf }}">
            <input type="hidden" name="id" value="{{ row.repo.id }}">
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" name="action" value="check" {{ (row.running or row.blocked) ? 'disabled' : '' }}><i class="ti ti-search" aria-hidden="true"></i>Vérifier</button>
            <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2" name="action" value="pull" {{ (row.running or row.blocked) ? 'disabled' : '' }}><i class="ti ti-download" aria-hidden="true"></i>Pull</button>
            <a class="btn btn-outline-secondary" href="{{ base }}repository.form.php?id={{ row.repo.id|url_encode }}"
               title="Modifier le dépôt {{ row.repo.id }}" aria-label="Modifier le dépôt {{ row.repo.id }}">
              <i class="ti ti-settings" aria-hidden="true"></i><span class="ms-1">Modifier</span>
            </a>
          </form>
          <details><summary>Journal et historique</summary>
            <pre data-gitpull-log>{{ row.state.log|default('Aucune exécution.') }}</pre>
            <div data-gitpull-history>
            {% for event in row.state.history|default([])|reverse %}
              <p>{{ event.at|date('d/m/Y H:i:s') }} — {{ event.action }} — {{ event.status }} {{ event.error|default('') }}</p>
            {% endfor %}
            </div>
          </details>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="6">{{ error ? 'Liste non chargée : consultez le diagnostic ci-dessus.' : 'Aucun dépôt déclaré dans le manifeste.' }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p>Les compteurs indiquent une échéance ; l’exécution dépend du prochain passage du cron GLPI. Les états s’actualisent automatiquement.</p>
</div>
<script src="{{ path('/plugins/gitpull/js/dashboard.js') }}?v={{ dashboard_js_version }}"></script>
{% endautoescape %}
